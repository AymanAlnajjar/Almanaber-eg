# =============================================================================
# Production environment for docker-compose.prod.yml
#   cp .env.prod.example .env   then edit the values below.
#
# IMPORTANT: Replace every "example.com" with your real domain, and every
# "CHANGE_ME..." with a strong unique secret. This file is the single source of
# config for the whole production stack. Never commit the real .env.
# =============================================================================

# ── Domain (used by Caddy for HTTPS routing) ─────────────────────────────────
# DNS: point  example.com , www.example.com , api.example.com  at your server IP.
DOMAIN=example.com

# ── Registry images (only for docker-compose.registry.yml) ───────────────────
# Pre-built images pushed by the GitHub Action. Set <owner> to the GitHub owner.
# Leave these unset if you build on the server with docker-compose.prod.yml.
FRONTEND_IMAGE=ghcr.io/OWNER/almnabr-frontend:latest
BACKEND_IMAGE=ghcr.io/OWNER/almnabr-backend:latest

# ── Database (MySQL container) ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=almanabr
DB_USERNAME=almanabr_user
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password

# ── Laravel application ──────────────────────────────────────────────────────
APP_NAME="AlMnabr Consulting"
APP_ENV=production
APP_DEBUG=false
# Generate once, then paste here:
#   docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ── Mail — real SMTP for the contact form (required to send emails) ───────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="AlMnabr Consulting"
# Where contact-form notifications are sent:
CONTACT_RECIPIENT=you@example.com

# ── Filament admin (created on first boot by AdminUserSeeder) ────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── Frontend (Next.js) — baked in at BUILD time ──────────────────────────────
# After changing any NEXT_PUBLIC_* value, rebuild the frontend image.
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=966000000000
NEXT_PUBLIC_WHATSAPP_MESSAGE="Hello AlMnabr, I'd like to know more about your services."
